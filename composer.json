{
    "name": "tornado-engine/broker",
    "description": "Tornado Engine core-module: people in chosen roles reach Claude only as pseudonyms.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "laravel/mcp": "^1.1.2",
        "tornado-engine/cron": ">=0.6",
        "tornado-engine/access": ">=0.8"
    },
    "autoload": {
        "psr-4": {
            "TornadoEngine\\Broker\\": "src/"
        }
    },
    "extra": {
        "tornado": {
            "name": "Broker",
            "core": ">=0.21",
            "core-module": true,
            "provider": "TornadoEngine\\Broker\\BrokerServiceProvider",
            "settings": "/administration/broker"
        },
        "branch-alias": {
            "dev-main": "0.15.x-dev"
        }
    }
}
